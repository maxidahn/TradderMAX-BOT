# ── Celerity v2 — copiá este archivo a .env y completá ──────────────────────
# Binance Futures (creá la API en Binance con permiso de FUTURES + TRADING.
# NUNCA habilites permiso de RETIRO/WITHDRAWAL).
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false

# Modo: arrancá SIEMPRE en paper (no toca tu dinero)
V2_PAPER=true
V2_PAPER_EQUITY=500

# Secreto del webhook — DEBE ser idéntico al "secret" del Pine Script
V2_WEBHOOK_SECRET=cambia-esto-por-algo-largo-y-unico

# Riesgo
V2_RISK_PCT=0.01          # 1% del equity por trade
V2_LEVERAGE=1             # 1x
V2_MAX_POSITIONS=2
V2_MAX_DAILY_LOSS_PCT=4   # kill switch diario
V2_MIN_NOTIONAL=20
V2_MAX_NOTIONAL=150

# Pares permitidos (whitelist)
V2_SYMBOLS=BTCUSDT,ETHUSDT

# Telegram (opcional — dejá vacío para desactivar)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Puerto del servidor (Railway lo setea solo)
PORT=8080

# ── Solo para la nube ────────────────────────────────────────────────────────
# Token para proteger el dashboard público. Si lo seteás, entrás con:
#   https://tu-servicio.up.railway.app/?token=EL_VALOR_DE_ABAJO
V2_DASHBOARD_TOKEN=

# Temporalidad y frecuencia de la estrategia (modo local)
V2_TIMEFRAME=4h
V2_POLL_SECONDS=900

# Carpeta de datos. En Railway, montá un Volume y apuntá esto a su ruta
# (ej. /data) para que el historial sobreviva a los redeploys.
DATA_DIR=data
